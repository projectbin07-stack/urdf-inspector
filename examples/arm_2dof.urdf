<?xml version="1.0"?>
<!--
  EXAMPLE MODEL written for urdf-inspector. Not modelled on any commercial
  robot; dimensions and masses are made up but physically consistent.

  A fixed-base two-joint arm: shoulder yaw about z, elbow pitch about y.
  With shoulder = a and elbow = b the tool point tool0 is at
    x = 0.2 cos(b) cos(a),  y = 0.2 cos(b) sin(a),  z = 0.30 - 0.2 sin(b)
  in the world frame, which the tests check.
-->
<robot name="example_arm_2dof">

  <material name="grey"><color rgba="0.55 0.57 0.6 1"/></material>
  <material name="orange"><color rgba="0.92 0.41 0.2 1"/></material>

  <!-- "world" is the conventional massless root that pins a fixed-base robot
       in Gazebo; it is not a REP 105 frame. -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.00221667" ixy="0" ixz="0" iyy="0.00221667" iyz="0" izz="0.0036"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="10" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="upper_arm">
    <inertial>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00267083" ixy="0" ixz="0" iyy="0.00267083" iyz="0" izz="0.000133333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.25"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.25"/></geometry>
    </collision>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="forearm">
    <inertial>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000045" ixy="0" ixz="0" iyy="0.0010225" iyz="0" izz="0.0010225"/>
    </inertial>
    <visual>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.03 0.03"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.03 0.03"/></geometry>
    </collision>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="forearm"/>
    <child link="tool0"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
  </joint>
  <link name="tool0"/>

  <ros2_control name="ArmSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

</robot>
