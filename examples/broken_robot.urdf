<?xml version="1.0"?>
<!--
  DELIBERATELY BROKEN EXAMPLE written for urdf-inspector. Not modelled on any
  commercial robot. Every comment marked "MISTAKE" is a problem the inspector
  should report. The file is still valid XML and loads in the inspector.
-->
<robot name="example_broken_robot">

  <material name="grey"><color rgba="0.55 0.57 0.6 1"/></material>

  <!-- MISTAKE: odom is published by odometry (REP 105), not by the URDF. -->
  <link name="odom"/>
  <joint name="odom_joint" type="fixed">
    <parent link="odom"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- MISTAKE: placeholder inertia of 1.0 kg m^2 for a 4 kg box. -->
  <link name="base_link">
    <inertial>
      <mass value="4.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.36 0.26 0.08"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.36 0.26 0.08"/></geometry>
    </collision>
  </link>

  <!-- MISTAKE: the wheel cylinder is not rotated upright (no rpy on the shape). -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.15 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1" velocity="10"/>
  </joint>
  <link name="left_wheel">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000135" ixy="0" ixz="0" iyy="0.000135" iyz="0" izz="0.00025"/>
    </inertial>
    <visual><geometry><cylinder radius="0.05" length="0.03"/></geometry></visual>
    <collision><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision>
  </link>

  <!-- MISTAKE: axis flipped relative to the left wheel, and lower/upper on a
       continuous joint. -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.15 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14" upper="3.14" effort="1" velocity="10"/>
  </joint>
  <link name="right_wheel">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000135" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.000135"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
  </link>

  <!-- MISTAKE: lower limit above upper limit, and the upper limit in degrees. -->
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0.1 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="1.0" upper="-1.0" effort="2" velocity="1"/>
  </joint>
  <!-- MISTAKE: principal moments break the triangle inequality (0.01 + 0.01 < 0.05). -->
  <link name="pan_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.05"/>
    </inertial>
    <visual><geometry><mesh filename="https://example.com/meshes/pan.stl"/></geometry></visual>
    <collision><geometry><mesh filename="https://example.com/meshes/pan.stl"/></geometry></collision>
  </link>

  <!-- MISTAKE: tilt angle limit written in degrees and zero effort. -->
  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-45" upper="90" effort="0" velocity="1"/>
  </joint>
  <!-- MISTAKE: no inertial on a link moved by a joint (Gazebo drops it and
       the camera below), and no collision. -->
  <link name="tilt_link">
    <visual>
      <geometry><box size="0.04 0.1 0.04"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- MISTAKE: rpy written in degrees; and the optical frame keeps the body
       axes instead of z forward, x right, y down. -->
  <joint name="camera_joint" type="fixed">
    <parent link="tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0.03 0 0" rpy="0 0 90"/>
  </joint>
  <link name="camera_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>

  <!-- MISTAKE: revolute joint without <limit>, prismatic joint with a zero axis,
       and a mimic of a joint that does not exist. -->
  <joint name="flap_joint" type="revolute">
    <parent link="base_link"/>
    <child link="flap"/>
    <origin xyz="-0.18 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <mimic joint="flap_motor_joint" multiplier="1"/>
  </joint>
  <link name="flap">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000336667" ixy="0" ixz="0" iyy="0.00000666667" iyz="0" izz="0.000336667"/>
    </inertial>
    <visual><geometry><box size="0.02 0.2 0.02"/></geometry></visual>
    <collision><geometry><box size="0.02 0.2 0.02"/></geometry></collision>
  </link>

  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lift"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="0" upper="0.1" effort="20" velocity="0.05"/>
  </joint>
  <link name="lift">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- MISTAKE: this link is not attached to anything. -->
  <link name="spare_link"/>

  <!-- MISTAKE: ros2_control names a joint that is not in the model. -->
  <ros2_control name="BrokenSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_jiont">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
